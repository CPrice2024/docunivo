{
  "name": "docunivo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && vite build --ssr src/prerender.tsx --outDir .prerender && node scripts/build-pages.mjs && node --test scripts/seo.test.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/*.test.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0",
    "vite": "^8.3.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
